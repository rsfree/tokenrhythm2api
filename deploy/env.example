# 生产 .env —— 复制成 /opt/trpool/.env 后填值，权限 600
#
# 这个文件本身**不入库**（.gitignore 已排除 .env），这里只是键名与格式参考。

# 面板 / 管理接口令牌。自己生成：openssl rand -hex 32
TRPOOL_ADMIN_KEY=

# 下发给客户端的密钥，逗号分隔。多个 client key 便于按客户回收
TRPOOL_CLIENT_KEYS=

# 镜像版本号，与 git tag 同版本**不带 v**（v0.0.28 → 0.0.28）。
# 必填：compose 里用的是 ${TRPOOL_IMAGE_TAG:?}，缺这个键会直接启动失败，
# 而不是静默拉起一个老镜像。
TRPOOL_IMAGE_TAG=0.0.28

# 上游地址
TRPOOL_UPSTREAM=https://tokenrhythm.studio
